# Dependencies
node_modules/

# Graph codegen / build output
generated/
build/

# Env / secrets — NEVER commit keys or mnemonics
.env
.env.local

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*

# Local agent harness config — not protocol source. No trailing slash: in a checkout
# these are symlinks to the workspace copy one level up, and a "name/" pattern matches
# a real directory only, so it leaves the symlink untracked-but-visible for `git add -A`
# to stage as a link that dangles for everyone else.
.axa
AXA.md
.claude
CLAUDE.md

# Matchstick compile artifacts (wasm + run metadata), written next to the tests
tests/.bin/
tests/.latest.json
